{
  "expo": {
    "name": "سعي",
    "slug": "saey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saey",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F5F2",
    "ios": {
      "bundleIdentifier": "com.saey.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.saey.app",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F2",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E0E0F",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2346F5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج سعي الوصول لصورك لإرسالها في الدردشة أو لتغيير صورتك الشخصية.",
          "cameraPermission": "يحتاج سعي الكاميرا لتصوير أسئلة الامتحانات والصور في الدردشة."
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/thmanyahsans-Regular.otf",
            "./assets/fonts/thmanyahsans-Medium.otf",
            "./assets/fonts/thmanyahsans-Bold.otf",
            "./assets/fonts/thmanyahserifdisplay-Black.otf"
          ],
          "widgets": [
            {
              "name": "Exemption",
              "label": "طريق الإعفاء",
              "description": "معدلك الحالي وكم بقي للإعفاء",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "NextExam",
              "label": "الامتحان القادم",
              "description": "عدّ تنازلي لأقرب امتحان",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "Tasks",
              "label": "مهامي",
              "description": "الواجبات والتحضيرات القادمة",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "maxResizeHeight": "300dp"
            },
            {
              "name": "Overview",
              "label": "لمحة سعي",
              "description": "المعدل، الامتحان، الرسائل، الإشعارات",
              "minWidth": "250dp",
              "minHeight": "50dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal"
            },
            {
              "name": "News",
              "label": "أخبار المدرسة",
              "description": "آخر خبر من الإدارة",
              "minWidth": "250dp",
              "minHeight": "50dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "Quick",
              "label": "اختصارات سعي",
              "description": "اسأل سعي، صوّر سؤال، المؤقت، أضف درجة",
              "minWidth": "250dp",
              "minHeight": "50dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal"
            }
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "auto"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
